{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/elydelva/one/catalog/schema/v1.json",
  "title": "service.yaml",
  "description": "One CLI catalog service definition (v0.3: handler allowlists)",
  "type": "object",
  "required": ["version", "id", "name", "actions"],
  "properties": {
    "version": {
      "type": "integer",
      "enum": [1],
      "description": "Schema version"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$",
      "description": "Unique service identifier (lowercase, no spaces)"
    },
    "name": {
      "type": "string",
      "description": "Human-readable service name"
    },
    "description": {
      "type": "string",
      "description": "Short service description"
    },
    "auth": {
      "type": "object",
      "properties": {
        "providers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["oauth2_user", "oauth2_device", "oauth2_client", "pat", "api_key", "aws_keys"]
          }
        }
      }
    },
    "actions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["description", "permission"],
        "properties": {
          "description": { "type": "string" },
          "permission": { "type": "string" },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type"],
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string" },
                "required": { "type": "boolean" },
                "description": { "type": "string" }
              }
            }
          },
          "handler": {
            "type": "object",
            "required": ["file", "sha256", "host_api_version"],
            "properties": {
              "file": { "type": "string" },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "host_api_version": { "type": "integer", "enum": [1] },
              "entry": { "type": "string" },
              "calls": {
                "type": "array",
                "items": { "type": "string" }
              },
              "credentials": {
                "type": "array",
                "items": { "type": "string" }
              },
              "fail_codes": {
                "type": "array",
                "items": { "type": "string" }
              },
              "memory_mb": { "type": "integer", "minimum": 1, "maximum": 256 },
              "cpu_seconds": { "type": "integer", "minimum": 1, "maximum": 120 }
            }
          }
        }
      }
    }
  }
}
